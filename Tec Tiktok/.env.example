# ---- Discord ----
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=            # optional: set for instant guild-scoped slash command registration

# ---- TikTok Developer App ----
# Get these from https://developers.tiktok.com/ -> Manage apps -> your app
# NEVER paste real values into Discord, chat, email, or version control.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/callback

# ---- OAuth callback server ----
OAUTH_SERVER_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000   # change to your public HTTPS URL in production

# ---- Token storage encryption ----
# 32-byte hex key used to encrypt tokens at rest (generate with: openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=
