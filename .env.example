# API Configuration
PORT=3000
API_BASE_URL=http://localhost:3000
API_AUTH_TOKEN=super-secret-auth-token-between-bot-and-api
ALLOWED_ORIGIN=http://localhost:3000

# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here

# Bot Permissions & Channel Setup
CLIPPER_ROLE_ID=clipper_role_id_here

# System Settings
MAX_FILE_SIZE_BYTES=26214400 # 25 MB
RATE_LIMIT_WINDOW_MS=3600000 # 1 hour
RATE_LIMIT_MAX_SUBMISSIONS=3 # Max submissions per clipper in the window

# Sentry DSN (Optional)
SENTRY_DSN=

# Airtable Configuration
AIRTABLE_API_KEY=your_personal_access_token_here
AIRTABLE_BASE_ID=your_base_id_here
AIRTABLE_SUBMISSIONS_TABLE=Submissions
AIRTABLE_CREATORS_TABLE=Creators

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
R2_PUBLIC_URL=https://your-r2-public-url.com

# Dashboard Credentials
ADMIN_USER=navaneeth
ADMIN_PASS=Navaneethmp007

# YouTube Data API Key (Required for auto view tracking)
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Airtable Tables
AIRTABLE_TEAM_MEMBERS_TABLE=Team Members

# View Checking Loop Interval (in seconds - default is 300 seconds / 5 mins)
VIEW_CHECK_INTERVAL_SECONDS=300

# TikTok API Configuration (for TikTok view tracking)
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_REDIRECT_URI=https://your-api-domain.com/api/tiktok/callback