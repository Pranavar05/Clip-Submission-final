### 1. Database Schema Design (PostgreSQL)

We will replace the local SQLite databases (`tokens.db`, `queue.db`, `mock_submissions.db`) with a single PostgreSQL connection. The tables will be:

```sql
-- Sequence for generating human-readable sequential submission IDs (e.g., SUB-000001)
CREATE SEQUENCE IF NOT EXISTS submission_id_seq START 1;

-- Table for active Creators
CREATE TABLE IF NOT EXISTS creators (
  id VARCHAR(50) PRIMARY KEY,
  name VARCHAR(255) NOT NULL,
  active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- Table for active Campaigns (optional database tracking)
CREATE TABLE IF NOT EXISTS campaigns (
  id VARCHAR(50) PRIMARY KEY,
  name VARCHAR(255) NOT NULL,
  status VARCHAR(50) NOT NULL DEFAULT 'Active',
  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- Table for Upload Tokens (portal sessions)
CREATE TABLE IF NOT EXISTS upload_tokens (
  token UUID PRIMARY KEY,
  user_id VARCHAR(50) NOT NULL,
  discord_user VARCHAR(255) NOT NULL,
  display_name VARCHAR(255) NOT NULL,
  server_id VARCHAR(50) NOT NULL,
  channel_id VARCHAR(50) NOT NULL,
  expires_at TIMESTAMP WITH TIME ZONE NOT NULL,
  used BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- Table for Video Submissions tracking lifecycle state
CREATE TABLE IF NOT EXISTS submissions (
  id VARCHAR(50) PRIMARY KEY, -- Formatted: SUB-000001
  token UUID REFERENCES upload_tokens(token) ON DELETE SET NULL,
  user_id VARCHAR(50) NOT NULL,
  discord_username VARCHAR(255) NOT NULL,
  creator_id VARCHAR(50) REFERENCES creators(id) ON DELETE RESTRICT,
  clip_type VARCHAR(50) NOT NULL, -- Raw, Edited, Stolen
  description TEXT,
  bucket VARCHAR(255) NOT NULL,
  object_key VARCHAR(255) NOT NULL,
  size_bytes BIGINT DEFAULT 0,
  original_filename VARCHAR(255),
  status VARCHAR(50) NOT NULL DEFAULT 'CREATED', -- CREATED, UPLOADING, UPLOADED, READY_FOR_REVIEW, APPROVED, REJECTED, FAILED
  server_id VARCHAR(50),
  channel_id VARCHAR(50),
  submitted_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- Table for Audit Logging
CREATE TABLE IF NOT EXISTS audit_logs (
  id SERIAL PRIMARY KEY,
  action VARCHAR(255) NOT NULL, -- e.g., TOKEN_GENERATION, CAMPAIGN_CHANGE
  actor_id VARCHAR(50) NOT NULL,
  actor_username VARCHAR(255) NOT NULL,
  details TEXT,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- Table for Review History
CREATE TABLE IF NOT EXISTS review_history (
  id SERIAL PRIMARY KEY,
  submission_id VARCHAR(50) REFERENCES submissions(id) ON DELETE CASCADE,
  reviewer_id VARCHAR(50) NOT NULL,
  action VARCHAR(50) NOT NULL, -- APPROVED, REJECTED
  note TEXT,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);
```

