# Copy this file to .env and fill in your real values. Never commit .env.

# Airtable Personal Access Token — create at https://airtable.com/create/tokens
# Needs scopes: data.records:read, data.records:write  on your New Tec base
AIRTABLE_API_KEY=your_airtable_api_key_here

# Your base ID, starts with "app..." — found in the Airtable API docs for your base
AIRTABLE_BASE_ID=your_airtable_base_id_here

# Table names (only change these if you renamed the tables)
SUBMISSIONS_TABLE=Submissions
CAMPAIGNS_TABLE=Campaigns

# How often the service checks Airtable for new/changed views, in seconds
POLL_INTERVAL_SECONDS=60
YOUTUBE_API_KEY=your_youtube_api_key_here